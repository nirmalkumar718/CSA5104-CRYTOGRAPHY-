#include <stdio.h>

int main()
{
    char m[5][5]={
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };

    char s[]="KXJEYUREBEZWEHEWRYTU";
    int i,j,r1,c1,r2,c2;

    printf("Decrypted text: ");

    for(i=0;s[i] && s[i+1];i+=2)
    {
        for(j=0;j<25;j++)
        {
            if(m[j/5][j%5]==s[i])
            {
                r1=j/5;c1=j%5;
            }
            if(m[j/5][j%5]==s[i+1])
            {
                r2=j/5;c2=j%5;
            }
        }

        if(r1==r2)
        {
            c1=(c1+4)%5;
            c2=(c2+4)%5;
        }
        else if(c1==c2)
        {
            r1=(r1+4)%5;
            r2=(r2+4)%5;
        }
        else
        {
            j=c1;c1=c2;c2=j;
        }

        printf("%c%c",m[r1][c1],m[r2][c2]);
    }

    return 0;
}
