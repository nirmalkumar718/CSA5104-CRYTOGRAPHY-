#include <stdio.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b, i, p;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if(gcd(a, 26) != 1)
    {
        printf("Invalid value of a");
        return 0;
    }

    for(i = 0; text[i]; i++)
    {
        p = toupper(text[i]) - 'A';
        text[i] = (a*p + b)%26 + 'A';
    }

    printf("Encrypted text: %s", text);

    return 0;
}
