#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter key: ");
    scanf("%99s", key);

    for(i = 0; text[i]; i++)
    {
        int p = toupper(text[i]) - 'A';
        int k = toupper(key[j]) - 'A';

        text[i] = (p + k) % 26 + 'A';

        j++;
        if(key[j] == '\0')
            j = 0;
    }

    printf("Encrypted text: %s", text);

    return 0;
}
