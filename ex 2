#include <stdio.h>
#include <ctype.h>

int main()
{
    char text[100];
    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i, pos;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            pos = toupper(text[i]) - 'A';
            text[i] = isupper(text[i]) ?
                key[pos] : tolower(key[pos]);
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
